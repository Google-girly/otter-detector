{
  "buildCommand": "cd labeling-ui && npm install && npm run build",
  "outputDirectory": "labeling-ui/dist",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{labeling-ui/**,dataset/**,annotated/**,annotated_v1/**,*.html,*.md,db/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
